# Python
__pycache__/
*.py[cod]
.venv/
venv/

# macOS
.DS_Store

# Local Claude Code settings (machine-specific)
.claude/settings.local.json

# Anything derived from live session transcripts (prompts, paths)
data/private/

# Secrets (template: .env.example)
.env
.env.*
!.env.example

# examples/golden working output (regenerated by demo.py)
examples/golden/out/

# Node: one install for the CLI, the hub and the sandbox providers (package.json at the root)
node_modules/

# app/: what opt and the hub write when run from this checkout (OPT_HOME moves it elsewhere).
# Run output and session ids, labels, task text — never committed.
app/results/
app/exports/
app/replays/
app/local-sessions/
app/tuning/
app/analysis/
app/audit/
app/sandbox-out/
app/bench/
app/otel/
app/claude-profile/
app/.authcode
# built page and packaging output — regenerated (npm run build:web, app/packaging/make-dist.sh)
app/web/dist/
app/deploy/snapshot/
app/deploy/build/
app/packaging/dist/
# confidential source material: investor documents are dropped in locally, never committed
app/tasks/pitch/inputs/*.html
app/docs/canarian_*.html
*.log
# opt claude optimize: the router's per-project memory (session ids, class history)
app/ult/
