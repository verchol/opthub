# The agent sandbox: Claude Code, a toolchain, and nothing that needs root.
#
# Deliberately not alpine — Claude Code and several npm postinstall scripts
# expect glibc, and debugging a musl-only failure inside a sandbox with no
# egress is a bad afternoon.
FROM node:22-bookworm-slim

RUN apt-get update && apt-get install -y --no-install-recommends \
      git ca-certificates curl python3 python3-pip ripgrep jq \
  && rm -rf /var/lib/apt/lists/*

# Installed at build time, while the image still has open egress. At run time
# the allowlist is in force and npm is not on it.
RUN npm install -g @anthropic-ai/claude-code@latest && npm cache clean --force

# The agent runs as a normal user. /work/out is the only writable mount it gets;
# the rootfs itself is mounted read-only by sandbox.sh.
RUN useradd -m -u 10001 -s /bin/bash agent \
 && mkdir -p /work/src /work/out && chown -R agent:agent /work
USER agent
WORKDIR /work/out

ENV HOME=/home/agent \
    NPM_CONFIG_UPDATE_NOTIFIER=false \
    IS_SANDBOX=1

CMD ["bash"]
