# opthub — every secret, in one file.
#
#   cp .env.example .env          # .env is gitignored; never commit it
#   python3 tools/envfile.py check
#
# Each value is a literal or an op://vault/item/field 1Password reference. Without the
# 1Password CLI, write literals. A variable exported in your shell overrides this file.
# tools/rerun.py and opt (app/) load this file themselves; for anything else:
#   python3 tools/envfile.py run -- <command>
#
# Nothing below is needed for the read-only tools or examples/golden (offline mode).

# --- Claude: replaying sessions (tools/rerun.py run|judge, examples/golden --live) ----------
# `claude setup-token` prints it (sk-ant-oat…). Subscription billing.
CLAUDE_CODE_OAUTH_TOKEN=

# API key (sk-ant-api…): leave EMPTY on a Claude plan. When both are set Claude Code prefers
# the API key and bills API credits. Only for E2B arms with AUTH_MODE=api-key.
ANTHROPIC_API_KEY=

# --- Jev classifier: J2 email-triage, J3 session-triage, hub Triage -------------------------
# Only booleans and counts are ever sent (CLAUDE.md, Privacy).
JEV_API_KEY=
# JEV_ENDPOINT=https://api.typesafe.ai/v1/systemone
# JEV_MODEL=jev-1.13.0

# --- sandbox/e2b: the E2B provider (cloud microVM arms) ----------------------------------------
# https://e2b.dev/dashboard?tab=keys   free tier, no card
E2B_API_KEY=
# E2B_TEMPLATE=

# Bedrock upstream: Kong template and ULT routing
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# AWS_REGION=eu-north-1

# Optional tracing of sandbox runs
LANGSMITH_API_KEY=

# Basic-auth password for the deployed read-only hub (a Fly secret in production)
HUB_PASSWORD=

# --- not secrets, listed so one file holds the whole setup -----------------------------------
# OLLAMA_HOST=http://localhost:11434
